; Keywords
(keyword) @keyword

; Type keywords
(type_keyword) @type.builtin

; Booleans and null
(boolean) @boolean
(null) @constant.builtin

; Literals
(string) @string
(number) @number

; Comments
(comment) @comment

; Function and method calls
(method_call) @function.method
(function_call) @function

; Operators
(operator) @operator

; Punctuation
(punctuation) @punctuation.bracket

; Identifiers (fallback - will color everything else)
(identifier) @variable
